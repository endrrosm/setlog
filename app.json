{
  "expo": {
    "name": "Setlog",
    "slug": "setlog",
    "version": "1.0.0",
    "icon": "./assets/icons/icon.png",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "ios": {
      "supportsTablet": true,
      "bundleIdentifier": "com.setlog.fitness"
    },
    "android": {
      "package": "com.setlog.fitness",
      "adaptiveIcon": {
        "foregroundImage": "./assets/icons/adaptive-foreground.png",
        "monochromeImage": "./assets/icons/adaptive-monochrome.png",
        "backgroundColor": "#d5fa68"
      }
    },
    "web": {
      "name": "Setlog",
      "themeColor": "#111411",
      "favicon": "./assets/icons/favicon.png"
    },
    "extra": {
      "eas": {
        "projectId": "b9d95fc9-7d2a-49b0-8b72-47bfc83ad9f6"
      }
    },
    "plugins": [
      "expo-status-bar"
    ]
  }
}
